# cs2-watcher configuration (loaded by the `watcher` service via env_file).
# Copy to cs2/cs2.env and fill in the blanks.
# Keep this file private — it holds your Steam password. chmod 600.
#
# After filling STEAM_USER / STEAM_PASS below, do the one-time interactive login:
#   cd /home/cisco/website && docker compose run --rm watcher login
# then start everything:
#   docker compose up -d

# --- Steam credentials (needed to DOWNLOAD a build; detection is login-free) ---
STEAM_USER=
STEAM_PASS=
# --- What to watch ---
STEAM_APPID=730            # 730 = Counter-Strike 2
STEAM_DEPOT=2347771        # win64 binaries depot
STEAM_BRANCH=public        # the live game

# Basenames to keep from each build (comma-separated). Empty = whole depot.
STEAM_FILES=animationsystem.dll,client.dll,engine2.dll,filesystem_stdio.dll,host.dll,inputsystem.dll,localize.dll,matchmaking.dll,materialsystem.dll,materialsystem2.dll,meshsystem.dll,navsystem.dll,networksystem.dll,panorama.dll,panoramauiclient.dll,particles.dll,rendersystemdx11.dll,rendersystemempty.dll,rendersystemvulkan.dll,resourcesystem.dll,scenefilecache.dll,scenesystem.dll,schemasystem.dll,server.dll,soundsystem.dll,tier0.dll,vphysics2.dll,worldrenderer.dll,cs2.exe

# --- Behaviour ---
POLL_INTERVAL=300                 # seconds between update checks
COMPRESSION=7z                    # 7z (solid LZMA2, ~54% smaller) | deflate | lzma | bzip2 | store (.zip)
DOWNLOAD_LATEST_ON_START=false    # we already have the current build; only grab NEW ones

# --- Webhook notifications (leave WEBHOOK_URL blank to disable) ---
WEBHOOK_URL=
WEBHOOK_FORMAT=auto
WEBHOOK_EVENTS=startup,detected,completed,failed

# Public URL of the site, used to build download links in notifications.
PUBLIC_BASE_URL=https://cs2.laine.lol
